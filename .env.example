# Get a free key at https://aistudio.google.com/apikey
# This is read on the server only — do NOT prefix it with VITE_ (that would ship it to every visitor's browser).
GEMINI_API_KEY=your-key-here

# Optional: override the model. Defaults to gemini-3.6-flash with automatic fallbacks.
# GEMINI_MODEL=gemini-3.6-flash
