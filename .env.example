# ─── Required for AI explanations (free): https://aistudio.google.com/apikey ───
# Server-only. Do NOT prefix with VITE_ (that would publish it to every visitor).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# ─── Strongly recommended (free): https://www.last.fm/api/account/create ───
# Real "listeners also play" similarity data.
LASTFM_API_KEY=

# ─── Optional shared cache (free tier): Vercel → Storage/Marketplace → Upstash for Redis ───
# Vercel fills these in automatically when you connect the database.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# ─── Optional: "Save to Spotify" (free, Spotify Premium needed for the app owner) ───
# https://developer.spotify.com/dashboard → Create app → Web API
SPOTIFY_CLIENT_ID=

# ─── Optional: "Save to Apple Music" (needs paid Apple Developer Program) ───
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# APPLE_ALLOWED_ORIGINS=https://your-app.vercel.app
